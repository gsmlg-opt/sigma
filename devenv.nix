{
  pkgs,
  lib,
  config,
  inputs,
  ...
}: let
  pkgs-stable = import inputs.nixpkgs-stable {system = pkgs.stdenv.system;};
  # DuskMoon's precompiled NIFs (duskmoon_vize >= 10.0.9) need glibc >= 2.43,
  # so BEAM must come from a nixpkgs with a new enough glibc.
  pkgs-unstable = import inputs.nixpkgs-unstable {system = pkgs.stdenv.system;};

  # The sigma process runs a release, so source/config edits need a rebuild
  # and restart. devenv's watcher only throttles for 100ms, so `sigma-reload`
  # is restarted on every change and writes `reloadTrigger` after 15s quiet.
  reloadState = "${config.devenv.state}/sigma-reload";
  reloadTrigger = "${reloadState}/restart";
  reloadFresh = "${reloadState}/fresh";
  appNames = builtins.attrNames (lib.filterAttrs (_: type: type == "directory") (builtins.readDir ./apps));
  appPaths = lib.concatMap (app: [./apps/${app}/lib ./apps/${app}/mix.exs]) appNames;
in {
  env.GREET = "Sigma";
  env.MIX_TAILWIND_PATH = "${pkgs-stable.tailwindcss_4}/bin/tailwindcss";
  env.MIX_BUN_PATH = "${pkgs-stable.bun}/bin/bun";
  env.NODE_PATH = "${config.git.root}/deps";

  packages = with pkgs-stable;
    [
      git
      figlet
      lolcat
      watchman
      tailwindcss_4
      deno
      pkg-config
      openssl
      cargo
      rustc
      stdenv.cc
      pkgs-unstable.beam28Packages.elixir-ls
    ]
    ++ lib.optionals stdenv.isLinux [
      bubblewrap
      inotify-tools
    ];

  languages.elixir.enable = true;
  languages.elixir.package = pkgs-unstable.beam28Packages.elixir;

  languages.javascript.enable = true;
  languages.javascript.pnpm.enable = true;
  languages.javascript.bun.enable = true;
  languages.javascript.bun.package = pkgs-stable.bun;

  scripts.hello.exec = ''
    figlet -w 120 $GREET | lolcat
  '';

  processes.sigma = {
    exec = ''
      set -euo pipefail
      mix sigma.rel-build
      exec _build/dev/sigma_rel/rel/sigma/bin/sigma start
    '';
    after = ["sigma:reload-init"];
    watch.paths = [reloadTrigger];
  };

  tasks."sigma:reload-init".exec = ''
    mkdir -p ${reloadState}
    touch ${reloadTrigger} ${reloadFresh}
  '';

  processes.sigma-reload = {
    exec = ''
      set -euo pipefail
      trap 'kill "$sleeper" 2>/dev/null; exit 0' TERM INT
      if [ -e ${reloadFresh} ]; then
        rm -f ${reloadFresh}
      else
        sleep 15 & sleeper=$!
        wait "$sleeper"
        echo "Elixir sources quiet for 15s; restarting sigma"
        # Write data: devenv ignores metadata-only events such as `touch`.
        date +%s > ${reloadTrigger}
      fi
      while :; do
        sleep 3600 & sleeper=$!
        wait "$sleeper"
      done
    '';
    after = ["sigma:reload-init"];
    watch = {
      paths =
        [
          ./config
          ./mix.exs
          ./mix.lock
          ./apps/sigma_web/assets
          ./native/sigma_terminal_helper/src
          ./native/sigma_terminal_helper/Cargo.toml
        ]
        ++ appPaths;
      extensions = ["ex" "exs" "heex" "eex" "lock" "js" "ts" "css" "rs" "toml"];
      # Generated by `duskmoon.bundle` during the release build.
      ignore = ["duskmoon_elements.js"];
    };
  };

  enterShell = ''
    hello
  '';
}
